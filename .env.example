# Supabase Config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mercado Pago Config
# Utiliza las mismas llaves del proyecto anterior o unas nuevas.
# Nota: La llave pública (VITE_MERCADOPAGO_PUBLIC_KEY) se carga en el frontend.
# La llave de acceso (MERCADOPAGO_ACCESS_TOKEN) se utiliza en las serverless functions/backend.
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-437d57f3-f894-4555-9b85-9da1104a8cb9
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
