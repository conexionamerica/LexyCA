# 1. Supabase (Producción)
# Extrae estas llaves desde: Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto-prod.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-produccion

# 2. Mercado Pago (Live Credentials)
# MUY IMPORTANTE: Usa las "Credenciales de Producción", no las de prueba.
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx-xxxx-xxxx-xxxx

# 3. Autenticación Superadmin
# Estas son las credenciales para acceder a la ruta /dashboard/admin
VITE_SUPERADMIN_EMAIL=emaildeconexionamerica@gmail.com
VITE_SUPERADMIN_PASSWORD=AlyRoberto2026*

# 4. Evolution API (WhatsApp)
# Servidor donde esté montada tu instancia de WhatsApp
VITE_EVOLUTION_API_URL=https://tu-servidor-evolution.com
VITE_EVOLUTION_API_KEY=tu-api-key-global
VITE_EVOLUTION_INSTANCE_NAME=LexyIdiomas

# 5. Configuración de Entorno
# Cambiar a 'production' cuando se suba a Vercel
NODE_ENV=production
