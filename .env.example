# ==========================================
# LEXY IDIOMAS - VARIÁVEIS DE AMBIENTE
# ==========================================
# Regra de ouro: variáveis com prefixo VITE_ são embutidas no JavaScript público do site.
# NUNCA coloque chaves secretas em variáveis VITE_.

# ---------- Frontend (públicas) ----------
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# ---------- Servidor (Vercel > Settings > Environment Variables) ----------
# Supabase service role (Project Settings > API > service_role). SECRETA.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (Minha Conta > Integrações > Chave de API). SECRETA.
# O ambiente é detectado pelo prefixo: $aact_prod_... = produção, $aact_hmlg_... = sandbox.
ASAAS_API_KEY=
# Opcional: força a URL da API (ex.: https://sandbox.asaas.com/api/v3)
ASAAS_API_URL=
# Opcional: walletId para split de pagamento
ASAAS_WALLET_ID=
# Token do webhook: gere um valor aleatório longo e cadastre o MESMO valor no painel do Asaas
# (Integrações > Webhooks > Token de autenticação).
ASAAS_WEBHOOK_TOKEN=

# Evolution API (WhatsApp) - opcional
EVOLUTION_API_URL=
EVOLUTION_API_TOKEN=
EVOLUTION_INSTANCE_NAME=LexyIdiomas

# ---------- Admin ----------
# O acesso de administrador NÃO usa mais senha em variável de ambiente.
# Crie o usuário no Supabase Auth e defina profiles.role = 'admin'
# (veja o final de supabase/migrations/20261125_seguranca_rls.sql).
